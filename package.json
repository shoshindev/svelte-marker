{
  "name": "svelte-marker",
  "displayName": "Svelte Marker",
  "description": "Highlighter-style marks behind Svelte and SvelteKit syntax and names, so you can tell them apart from plain JavaScript, HTML and CSS.",
  "version": "0.0.10",
  "publisher": "shoshindev",
  "license": "MIT",
  "icon": "images/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/shoshindev/svelte-marker.git"
  },
  "engines": {
    "vscode": "^1.100.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "svelte",
    "sveltekit",
    "runes",
    "highlight",
    "highlighter",
    "syntax"
  ],
  "extensionDependencies": [
    "svelte.svelte-vscode"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": true
    }
  },
  "main": "./dist/extension.js",
  "activationEvents": [
    "onLanguage:svelte",
    "onLanguage:javascript",
    "onLanguage:typescript",
    "onLanguage:html"
  ],
  "contributes": {
    "commands": [
      {
        "command": "svelteMarker.toggle",
        "title": "Svelte Marker: Toggle Marks"
      }
    ],
    "colors": [
      {
        "id": "svelteMarker.background",
        "description": "Background color of the marks. Keep it translucent so the text stays readable.",
        "defaults": {
          "dark": "#8B5CF642",
          "light": "#8B5CF62E",
          "highContrast": "#8B5CF642",
          "highContrastLight": "#8B5CF62E"
        }
      }
    ]
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "check": "tsc --noEmit",
    "test": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test test/findMarks.test.ts test/svelteNames.test.ts",
    "vsix": "vsce package --no-dependencies",
    "shapes": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/generateShapes.ts",
    "audit-marks": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/audit.ts",
    "vscode:prepublish": "node notices.mjs && node esbuild.mjs --production"
  },
  "devDependencies": {
    "@sveltejs/adapter-auto": "8.0.1",
    "@sveltejs/adapter-cloudflare": "8.0.2",
    "@sveltejs/adapter-netlify": "7.0.1",
    "@sveltejs/adapter-node": "6.0.2",
    "@sveltejs/adapter-static": "4.0.1",
    "@sveltejs/adapter-vercel": "7.0.3",
    "@sveltejs/kit": "3.2.0",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@types/node": "24.19.2",
    "@types/vscode": "1.100.0",
    "@vscode/vsce": "4.1.0",
    "esbuild": "0.28.2",
    "ovsx": "1.3.0",
    "svelte": "5.57.3",
    "typescript": "7.0.2",
    "typescript-6": "npm:typescript@6.0.3"
  }
}
