{
  "name": "svelte-marker",
  "displayName": "Svelte Marker",
  "description": "Highlighter-style marks behind everything in a SvelteKit project that is not plain JavaScript, HTML or CSS.",
  "version": "0.0.4",
  "publisher": "shoshindev",
  "license": "MIT",
  "icon": "images/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/shoshindev/svelte-marker.git"
  },
  "engines": {
    "vscode": "^1.100.0"
  },
  "categories": [
    "Other"
  ],
  "extensionDependencies": [
    "svelte.svelte-vscode"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onLanguage:svelte",
    "onLanguage:javascript",
    "onLanguage:typescript",
    "onLanguage:html"
  ],
  "contributes": {
    "commands": [
      {
        "command": "svelteMarker.toggle",
        "title": "Svelte Marker: Toggle Highlighting"
      }
    ],
    "colors": [
      {
        "id": "svelteMarker.background",
        "description": "Background color of the marks. Keep it translucent so the text stays readable.",
        "defaults": {
          "dark": "#8B5CF642",
          "light": "#8B5CF62E",
          "highContrast": "#8B5CF642",
          "highContrastLight": "#8B5CF62E"
        }
      }
    ]
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "check": "tsc --noEmit",
    "test": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test test/findMarks.test.ts",
    "vsix": "vsce package --no-dependencies",
    "vscode:prepublish": "node notices.mjs && node esbuild.mjs --production"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "@types/vscode": "1.100.0",
    "@vscode/vsce": "4.1.0",
    "esbuild": "0.28.2",
    "svelte": "5.57.3",
    "typescript": "7.0.2"
  }
}
